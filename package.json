{
  "name": "rolling-fiefdoms-pnp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Rolling Fiefdoms (online version).",
  "scripts": {
    "lint": "eslint . --ext .js",
    "test": "npm run lint && vitest run",
    "serve": "node scripts/serve.js",
    "serve:dist": "node scripts/serve.js --dist",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && node scripts/build.js",
    "build:debug": "npm run clean && node scripts/build.js --sourcemap --brotli",
    "page:dev": "npx --yes wrangler pages dev dist --port 4173 --ip 0.0.0.0",
    "prepare": "husky"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.2",
    "svgo": "^4.0.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "brotli": "^1.3.3"
  }
}
