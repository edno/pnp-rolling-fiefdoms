name = "rolling-fiefdoms-signalling"
main = "worker.js"
compatibility_date = "2024-12-04"

[[durable_objects.bindings]]
name = "SIGNALLING"
class_name = "Signalling"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Signalling"]

[observability]
[observability.logs]
enabled = false
head_sampling_rate = 1
invocation_logs = true
persist = true
